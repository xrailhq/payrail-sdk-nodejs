# PayRail SDK Configuration

# Facilitator service URL - Your x402 payment processor (verify/settle endpoints)
# This is the service that handles payment verification and on-chain settlement
FACILITATOR_URL=http://localhost:3000

# Private key for signing transactions (hex format, with or without 0x prefix)
# NEVER commit your real private key! Use environment variables or a secure vault
# This is an Anvil test key for local development only
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# API Base URL - The paid service you want to access (returns 402 responses)
# This is the actual API/service that requires payment
API_BASE_URL=http://localhost:8080
