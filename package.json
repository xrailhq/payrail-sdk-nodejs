{
  "name": "@payrail/sdk-nodejs",
  "version": "0.1.0",
  "description": "Node.js SDK for x402 facilitator service - automatic payment handling for server-side applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "example": "tsx example.ts"
  },
  "keywords": [
    "x402",
    "payment",
    "facilitator",
    "blockchain",
    "sdk",
    "nodejs",
    "axios",
    "middleware"
  ],
  "author": "xRail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrailhq/payrail-sdk-js.git"
  },
  "homepage": "https://github.com/xrailhq/payrail-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/xrailhq/payrail-sdk-js/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ethers": "^6.9.0"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "engines": {
    "node": ">=16"
  }
}
